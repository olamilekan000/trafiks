# Build stage for Go agent
FROM golang:1.24-alpine AS go-builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy go mod files
COPY go.mod go.sum ./
RUN go mod download && go mod verify

# Copy source code
COPY . .

# Build the agent binary
RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo \
    -ldflags="-w -s" \
    -o /app/trafiks \
    ./cmd/agent/main.go

# Final stage
FROM alpine:latest

RUN apk --no-cache add ca-certificates tzdata

WORKDIR /app

# Copy binary from builder
COPY --from=go-builder /app/trafiks .

# Create config directory structure for default viper path
# Viper is configured to look in: $HOME/.config/trafiks
# Since we are running as root (no USER set), $HOME is /root
RUN mkdir -p /root/.config/trafiks

# Run agent with default config discovery (no explicit -config flag)
CMD ["./trafiks"]
